# Enquiries are emailed through FormSubmit to the address in src/content/site.js (forms.formsubmit).
# Optional overrides, set them in Vercel (Project Settings > Environment Variables) or a local .env file:

# Send enquiries to a different email address or FormSubmit alias without changing code.
VITE_FORMSUBMIT_TARGET=

# Post enquiries as JSON to your own backend instead of FormSubmit.
VITE_FORM_ENDPOINT=
